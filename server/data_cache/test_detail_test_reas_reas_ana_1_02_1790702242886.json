      "qNum": 2,
      "qType": "standard",
      "question": "उस विकल्प का चयन करें जो तीसरी संख्या से उसी प्रकार संबंधित है जिस प्रकार दूसरी संख्या पहली संख्या से संबंधित है: 8 : 81 :: 16 : ?",
      "options": [
        "256",
        "512",
        "625",
        "1024"
      ],
      "correctIndex": 2,
      "explanation": "पहला पद 8 है, जिसे $(2)^3$ लिखा जा सकता है। दूसरा पद 81 है, जिसे $(2+1)^4 = (3)^4 = 81$ लिखा जा सकता है। इसी नियम के अनुसार, तीसरा पद 16 है जो $(4)^2$ है। अगला पद $(4+1)^4 = (5)^4 = 625$ होगा।",
      "difficulty": "hard",
      "subject": "Reasoning",
      "topic": "समानता",
      "weightage": "high",
      "timestamp": "2026-10-24T18:30:05.961Z",
