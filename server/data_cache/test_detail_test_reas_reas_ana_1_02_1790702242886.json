    {
      "id": "q_test_reas_reas_ana_1_02_1790702242886_1",
      "qId": "q_test_reas_reas_ana_1_02_1790702242886_1",
      "qNum": 1,
      "qType": "standard",
      "question": "दी गई संख्या युग्मों में से वह विकल्प चुनिए जो पहली संख्या का दूसरी संख्या के साथ वही संबंध दर्शाता है जो नीचे दिए गए युग्म में है: 25 : 125",
      "options": [
        "36 : 216",
        "49 : 343",
        "16 : 64",
        "64 : 512"
      ],
      "correctIndex": 1,
      "explanation": "यहाँ संबंध $5^2 : 5^3$ अर्थात संख्या का वर्ग : उसका घन (Cube) है। 25 का संबंध 125 से है ($5^2 = 25$ और $5^3 = 125$)। इसी प्रकार, विकल्पों में $49 = 7^2$ और $343 = 7^3$ होता है। अतः 49 : 343 सही विकल्प है।",
      "difficulty": "moderate",
      "subject": "Reasoning",
      "topic": "समानता",
      "weightage": "high",
      "timestamp": "2026-10-24T18:30:05.961Z",
      "sourcePattern": "CG Vyapam Official Question Pattern",
      "yearTrend": "2020-2024",
      "expectedIn2026": true
    },
    {
