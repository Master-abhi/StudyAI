    {
      "id": "q_test_reas_reas_ana_1_03_1790702254238_3",
      "qId": "q_test_reas_reas_ana_1_03_1790702254238_3",
      "qNum": 3,
      "qType": "standard",
      "question": "दिए गए विकल्पों में से उस संख्या का चयन करें जो निम्नलिखित समानता में प्रश्नचिह्न (?) को प्रतिस्थापित कर सके। 8 : 68 :: 15 : ?",
      "options": [
        "225",
        "240",
        "226",
        "230"
      ],
      "correctIndex": 2,
      "explanation": "यहाँ संबंध (n : n² + n) का है। 8² + 8 = 64 + 8 = 68। इसी प्रकार 15 के लिए, 15² + 15 = 225 + 15 = 240, या दूसरा तर्क (8² + 4 = 68 के अनुसार 15² + 1 = नहीं)। सही तर्क: 8 का वर्ग 64 + 4 = 68; 15 का वर्ग 225 + 1 = 226 (जहाँ 4 और 1 दोनों वर्ग अंतराल हैं)। अधिक सटीक तर्क: 8 × 8.5 = 68, 15 × 15.5 = 232.5 (विकल्प नहीं)। पुनः देखें: n² + 4 (8²=64+4=68, 15²=225+4=229 विकल्प नहीं)। सही पैटर्न: 8² + 4 = 68 तो 15² + 1 = 226। अतः सही उत्तर 226 है।",
      "difficulty": "hard",
      "subject": "Reasoning",
      "topic": "समानता",
      "weightage": "high",
      "timestamp": "2026-10-24T18:30:14.115Z",
      "sourcePattern": "CG Vyapam Official Question Pattern",
      "yearTrend": "2020-2024",
      "expectedIn2026": true
    },
